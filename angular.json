{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "link-three-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/link-three-ui",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "./projects/link-three-view/src/assets/images/",
                "output": "./assets/link-three-view/"
              }
            ],
            "styles": [
              "src/styles.scss",
              "src/assets/styles/link-three-styles.scss",
              "src/assets/common-style/lt-styles.scss",
              "projects/link-three-view/src/assets/styles/link-three-view-styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "link-three-ui:build:production"
            },
            "development": {
              "browserTarget": "link-three-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "link-three-ui:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "link-three": {
      "projectType": "library",
      "root": "projects/link-three",
      "sourceRoot": "projects/link-three/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/link-three/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/link-three/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/link-three/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/link-three/src/test.ts",
            "tsConfig": "projects/link-three/tsconfig.spec.json",
            "karmaConfig": "projects/link-three/karma.conf.js"
          }
        }
      }
    },
    "link-three-api": {
      "projectType": "library",
      "root": "projects/link-three-api",
      "sourceRoot": "projects/link-three-api/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/link-three-api/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/link-three-api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/link-three-api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/link-three-api/src/test.ts",
            "tsConfig": "projects/link-three-api/tsconfig.spec.json",
            "karmaConfig": "projects/link-three-api/karma.conf.js"
          }
        }
      }
    },
    "link-three-view": {
      "projectType": "library",
      "root": "projects/link-three-view",
      "sourceRoot": "projects/link-three-view/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/link-three-view/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/link-three-view/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/link-three-view/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/link-three-view/src/test.ts",
            "tsConfig": "projects/link-three-view/tsconfig.spec.json",
            "karmaConfig": "projects/link-three-view/karma.conf.js"
          }
        }
      }
    },
    "link-three-core": {
      "projectType": "library",
      "root": "projects/link-three-core",
      "sourceRoot": "projects/link-three-core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/link-three-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/link-three-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/link-three-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/link-three-core/src/test.ts",
            "tsConfig": "projects/link-three-core/tsconfig.spec.json",
            "karmaConfig": "projects/link-three-core/karma.conf.js"
          }
        }
      }
    }
  },
  "defaultProject": "link-three-ui"
}
